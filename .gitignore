# captures & generated files — the app writes these under the storage folder you
# pick, never into the repo. Kept as a guard in case someone points it here.
screenshots/*.jpg
videos/*.mp4
archive/**/*.jpg

# temp files
_tc_*_filelist.txt

# backup files (history lives in git log/show)
TimeCap.py.bak_*

# personal config — now lives in ~/Library/Application Support/TimeCap/.
# Kept here to catch the legacy source-adjacent file, which is never tracked.
config.json

# internal Korean dev docs — local only
CLAUDE.md
TIMECAP.md
TIMECAP_BACKLOG.md

# local artifacts — only icon_source.png + TimeCap.icns are tracked
timecap_archive.zip
icon_source.jpg
icon.iconset/
logs/*.log

# build artifacts
build/
dist*/
.venv/

# system
.DS_Store
.claude/

# python
__pycache__/
